schema_version: 1

skills:
  - name: resource_control
    kind: runtime
    enabled: false
    config: {}

  - name: psi_gate
    kind: runtime
    enabled: false
    config: {}

  - name: network_policy_demo
    kind: runtime
    enabled: SMOKE_FALSE
    config:
      hook: cgroup_connect4
      cgroup_path: /sys/fs/cgroup/eulerpilot/demo-net
      mode: enforce
      dst_port: "18080"
