{
  "apiVersion": "eulerpilot.io/v1alpha1",
  "kind": "CgroupPolicy",
  "metadata": {"name": "protect-frontend-scope"},
  "spec": {
    "scope": "cgroup-effects",
    "source": "human",
    "effects": [
      {
        "path": "/sys/fs/cgroup/user.slice/user-1000.slice/session-1.scope",
        "cpu_weight": 300
      }
    ],
    "safety": {
      "policy_ttl_ms": 120000
    }
  }
}
