{
  "apiVersion": "eulerpilot.io/v1alpha1",
  "kind": "SchedulingPolicy",
  "metadata": {"name": "redis-latency-balanced"},
  "spec": {
    "scope": "scheduler-instance",
    "mode": "adaptive",
    "expert": "latency-balanced",
    "source": "rule-template",
    "targets": [
      {"kind": "cgroup", "path": "/sys/fs/cgroup/eulerpilot-v2/redis", "role": "FOREGROUND", "role_source": "explicit"},
      {"kind": "cgroup", "path": "/sys/fs/cgroup/eulerpilot-v2/background", "role": "BACKGROUND", "role_source": "explicit"}
    ],
    "parameters": {
      "lat_slice_ns": 1000000,
      "comp_slice_ns": 4000000,
      "cache_slice_ns": 8000000,
      "bg_slice_ns": 2000000,
      "preempt_threshold_ns": 500000,
      "bg_vtime_pct": 200,
      "llc_affinity": false
    },
    "safety": {
      "min_dwell_ms": 10000,
      "max_observation_age_ms": 2000,
      "heartbeat_period_ms": 250,
      "heartbeat_timeout_ms": 2000,
      "policy_ttl_ms": 60000,
      "quiet_max_regression_pct": 5,
      "evaluation_min_bg_progress_ratio": 0.3,
      "bg_work_unit": "calibrated-background-job-unit",
      "bg_progress_window_ms": 5000,
      "min_bg_work_units_per_sec": 100,
      "max_bg_wait_ms": 500,
      "fallback": "detach-to-fair",
      "allow_affinity_change": false
    }
  }
}
