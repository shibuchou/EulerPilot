flowchart TB
  %% EulerPilot detailed architecture overview.

  subgraph L1["1. 业务负载与验证目标"]
    direction LR
    W1["Redis / Nginx<br/>延迟敏感服务"]
    W2["stress-ng / make -j<br/>后台干扰任务"]
    W3["Container / Pod / cgroup<br/>真实目标对象"]
  end

  subgraph L2["2. openEuler 内核能力层"]
    direction LR
    K1["sched tracepoints<br/>wakeup / switch / migrate"]
    K2["PSI<br/>CPU / Memory / IO pressure"]
    K3["cgroup v2<br/>cpu / memory / io controller"]
    K4["sched_ext / scx<br/>SP4 源码自编译复核路径"]
    K5["BPF hooks<br/>LSM / TC / XDP / cgroup"]
    K6["BTF / CO-RE<br/>跨内核结构适配"]
  end

  subgraph L3["3. eBPF 观测与 Hook 层"]
    direction LR
    B1["workload_observer.bpf.c<br/>调度行为采样"]
    B2["task_stats / cgroup_stats / ringbuf<br/>结构化事件输出"]
    B3["network_*.bpf.c<br/>connect4 / TC QoS / XDP"]
    B4["security_policy.bpf.c<br/>LSM + syscall tracing"]
  end

  subgraph L4["4. 用户态 Agent 控制面"]
    direction LR
    A1["Runtime 主循环<br/>周期采样与生命周期管理"]
    A2["Snapshot Builder<br/>多源状态聚合"]
    A3["Workload Analyzer<br/>comm + eBPF 特征分类"]
    A4["PsiGate<br/>压力窗口门控"]
    A5["Policy Engine<br/>跨 Skill 决策"]
    A6["TargetResolver<br/>PID / cgroup / container / Pod"]
    A7["AuditBus + ActionJournal<br/>审计、事务、rollback"]
  end

  subgraph L5["5. Skills 能力层"]
    direction LR
    S1["CPU Schedule Skill<br/>cgroup/scx 后端选择"]
    S2["Resource Control Skill<br/>CPU + Memory + IO"]
    S3["Network Policy Skill<br/>connect4 / QoS / XDP"]
    S4["Security Policy Skill<br/>LSM enforce + anomaly"]
    S5["Benchmark / Evidence Skill<br/>实验、图表、报告"]
    S6["Rollback Skill<br/>stop/cleanup 恢复现场"]
  end

  subgraph L6["6. 执行与系统效果层"]
    direction LR
    E1["CgroupExecutor<br/>cpu.max / cpu.weight / memory.high / io.max"]
    E2["ScxExecutor + scx_eulerpilot<br/>class_map / DSQ / 调度策略"]
    E3["TC/XDP Executor<br/>lab veth / Pod host veth 限速与过滤"]
    E4["LSM Enforcer<br/>文件、ptrace、capability、cred"]
    E5["Status / Web Console<br/>只读展示 + 白名单 Demo"]
  end

  subgraph L7["7. 证据与交付层"]
    direction LR
    R1["Redis / Nginx / Mixed Benchmark<br/>RUNS=5 + CPU 效率"]
    R2["reports/events/*.jsonl<br/>统一 transaction_id"]
    R3["final_evidence_manifest.json<br/>strict evidence compact"]
    R4["Final Report / Defense / Demo<br/>中文报告与答辩材料"]
  end

