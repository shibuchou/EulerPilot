<mxfile host="EulerPilot" version="26.0.0"><diagram id="event-guard-decision" name="事件守卫的判定与动作"><mxGraphModel dx="1120" dy="1080" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1080" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_window" value="&lt;b&gt;新窗口与新鲜度&lt;/b&gt;&lt;br&gt;是否有新的有效证据&lt;br&gt;过期不猜测负载状态" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="120" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_hold" value="&lt;b&gt;NONE / STALE&lt;/b&gt;&lt;br&gt;不创建新效应&lt;br&gt;记录 last_hold 原因" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#B65B50;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="330" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_identity" value="&lt;b&gt;watch 身份与租约&lt;/b&gt;&lt;br&gt;path + kernfs id 一致&lt;br&gt;arm 属主与效应归属一致" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="330" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_rebuilt" value="&lt;b&gt;WATCH_REBUILT&lt;/b&gt;&lt;br&gt;授权目标已改变&lt;br&gt;回退并要求重新武装" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#B65B50;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="330" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_sustain" value="&lt;b&gt;尚无在位效应&lt;/b&gt;&lt;br&gt;连续 sustain 窗超阈&lt;br&gt;才允许提交新动作" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="160" y="550" width="340" height="117" as="geometry" /></mxCell><mxCell id="n_release" value="&lt;b&gt;已有在位效应&lt;/b&gt;&lt;br&gt;连续 release 窗回落&lt;br&gt;或策略 TTL 到期" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="620" y="550" width="340" height="117" as="geometry" /></mxCell><mxCell id="n_apply" value="&lt;b&gt;标准 policy.apply&lt;/b&gt;&lt;br&gt;经快照 / WAL / verify&lt;br&gt;受控提升 cpu.weight" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="160" y="780" width="340" height="117" as="geometry" /></mxCell><mxCell id="n_rollback" value="&lt;b&gt;标准补偿回退&lt;/b&gt;&lt;br&gt;恢复 previous&lt;br&gt;读回后确认结果" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="620" y="780" width="340" height="117" as="geometry" /></mxCell><mxCell id="e_0" value="无效" edge="1" parent="1" source="n_window" target="n_hold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#B65B50;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="190" y="178" /></Array></mxGeometry></mxCell><mxCell id="e_1" value="有效" edge="1" parent="1" source="n_window" target="n_identity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#2E6DA4;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_2" value="不符" edge="1" parent="1" source="n_identity" target="n_rebuilt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#B65B50;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_3" value="" edge="1" parent="1" source="n_identity" target="n_sustain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#2E6DA4;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="500" /><mxPoint x="330" y="500" /></Array></mxGeometry></mxCell><mxCell id="e_4" value="" edge="1" parent="1" source="n_identity" target="n_release" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#2E6DA4;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="500" /><mxPoint x="790" y="500" /></Array></mxGeometry></mxCell><mxCell id="e_5" value="满足" edge="1" parent="1" source="n_sustain" target="n_apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#238678;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_6" value="满足" edge="1" parent="1" source="n_release" target="n_rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#238678;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="text_title" value="事件守卫的判定与动作" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#17324D;"><mxGeometry x="40" y="22" width="1040" height="38" as="geometry" /></mxCell><mxCell id="text_subtitle" value="监控线程周期检查 · 观测不转授权限" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#17324D;"><mxGeometry x="40" y="65" width="1040" height="30" as="geometry" /></mxCell><mxCell id="text_note" value="泵断供时冻结新动作；同路径重建不继承旧授权，已有效应仍受 TTL 约束。" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#17324D;"><mxGeometry x="40" y="1025" width="1040" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
