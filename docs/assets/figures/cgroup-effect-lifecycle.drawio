e="1" parent="1" source="n_restore" target="n_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#238678;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_7" value="已恢复" edge="1" parent="1" source="n_restart" target="n_done" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#238678;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="text_title" value="cgroup 效应的完整生命周期" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=30;fontColor=#17324D;"><mxGeometry x="40" y="22" width="1040" height="38" as="geometry" /></mxCell><mxCell id="text_subtitle" value="快照、marker、读回与恢复形成闭环" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=21;fontColor=#17324D;"><mxGeometry x="40" y="65" width="1040" height="30" as="geometry" /></mxCell><mxCell id="text_note" value="域不匹配时零副作用拒绝；崩溃不会自动撤销权重，重启须按 marker 恢复。" vertex="1" parent="1" style="text;html=1;align=left;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontColor=#17324D;"><mxGeometry x="40" y="862" width="1040" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
