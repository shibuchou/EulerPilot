<mxfile host="EulerPilot" version="26.0.0"><diagram id="cgroup-effect-lifecycle" name="cgroup 效应的完整生命周期"><mxGraphModel dx="1120" dy="917" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="917" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_target" value="&lt;b&gt;解析与校验目标&lt;/b&gt;&lt;br&gt;CgroupPolicy / 授权路径&lt;br&gt;持有并核对目标身份" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_snapshot" value="&lt;b&gt;保存 previous&lt;/b&gt;&lt;br&gt;读取原值&lt;br&gt;独立 marker 落盘" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#2E6DA4;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_write" value="&lt;b&gt;写入并读回 desired&lt;/b&gt;&lt;br&gt;cpu.weight&lt;br&gt;验证实际值符合策略" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_restore" value="&lt;b&gt;显式回退与 TTL&lt;/b&gt;&lt;br&gt;恢复 previous&lt;br&gt;读回后清 marker" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="390" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_refresh" value="&lt;b&gt;刷新与漂移纠正&lt;/b&gt;&lt;br&gt;检查在位目标&lt;br&gt;外部改值后重新断言" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="390" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_crash" value="&lt;b&gt;执行服务被杀&lt;/b&gt;&lt;br&gt;内核权重仍保留&lt;br&gt;marker 不丢失" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#B65B50;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="390" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_restart" value="&lt;b&gt;同实例重启恢复&lt;/b&gt;&lt;br&gt;核对目标与归属&lt;br&gt;恢复原值或明确冲突" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#2E6DA4;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="640" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_done" value="&lt;b&gt;确认效应已撤销&lt;/b&gt;&lt;br&gt;读回原值&lt;br&gt;清理自有恢复记录" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="640" width="300" height="117" as="geometry" /></mxCell><mxCell id="e_0" value="" edge="1" parent="1" source="n_target" target="n_snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#2E6DA4;fontFamily=Microsoft YaHei;fontSize=20;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e_1" value="" edge="1" parent="1" source="n_snapshot" target="n_write" style="edgeStyle=o