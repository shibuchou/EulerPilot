<mxfile host="EulerPilot" version="26.0.0"><diagram id="bounded-autopilot" name="自动切换的受限决策通道"><mxGraphModel dx="1120" dy="1050" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1050" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_features" value="&lt;b&gt;FeatureWindow&lt;/b&gt;&lt;br&gt;CPU / load / PSI&lt;br&gt;valid / age / source" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#8595A5;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_router" value="&lt;b&gt;规则专家路由&lt;/b&gt;&lt;br&gt;阈值与滞回&lt;br&gt;输出档位及理由" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#2E6DA4;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_advisory" value="&lt;b&gt;默认建议模式&lt;/b&gt;&lt;br&gt;route / slo 可查询&lt;br&gt;不自动写内核" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EAF6F2;strokeColor=#238678;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_enable" value="&lt;b&gt;显式开启与租约&lt;/b&gt;&lt;br&gt;auto-policy / auto-owner&lt;br&gt;权限来源保持不变" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="390" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_evidence" value="&lt;b&gt;服务与事件证据门&lt;/b&gt;&lt;br&gt;新鲜度 / 绝对预算&lt;br&gt;比较