<mxfile host="EulerPilot" version="26.0.0"><diagram id="policy-apply-flow" name="策略生效与补偿流程"><mxGraphModel dx="1120" dy="1007" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1007" background="#FFFFFF"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n_submit" value="&lt;b&gt;01  CLI 提交&lt;/b&gt;&lt;br&gt;envelope + policy&lt;br&gt;幂等键与请求标识" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#8595A5;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_auth" value="&lt;b&gt;02  校验与授权&lt;/b&gt;&lt;br&gt;schema / 语义 / lease&lt;br&gt;fence / generation / 门控" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7E7;strokeColor=#B27812;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="410" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_bind" value="&lt;b&gt;03  解析目标身份&lt;/b&gt;&lt;br&gt;pidfd + starttime&lt;br&gt;cgroup FD / kernfs id" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#2E6DA4;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="780" y="130" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_wal" value="&lt;b&gt;04  快照先行&lt;/b&gt;&lt;br&gt;PREPARED + fsync&lt;br&gt;保存补偿所需原值" vertex="1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF5FC;strokeColor=#2E6DA4;strokeWidth=1.6;fontFamily=Microsoft YaHei;fontSize=22;fontColor=#17324D;spacing=12;align=left;verticalAlign=middle;"><mxGeometry x="40" y="345" width="300" height="117" as="geometry" /></mxCell><mxCell id="n_apply" value="&lt;b&gt;05  Skill 生效&lt;/b&gt;&lt;br&gt;s